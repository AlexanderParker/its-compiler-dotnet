{
  "$schema": "https://alexanderparker.github.io/instruction-template-specification/schema/v1.0/its-base-schema-v1.json",
  "version": "1.0.0",
  "extends": [
    "https://alexanderparker.github.io/instruction-template-specification/schema/v1.0/its-json-types-v1.json"
  ],
  "metadata": {
    "name": "JSON Types Test",
    "description": "Exercises the JSON type library: the template text authors the response JSON verbatim and placeholders fill value positions within it"
  },
  "variables": {
    "apiBaseUrl": "https://api.example.com/v2",
    "resourceName": "orders",
    "includeErrorExample": true
  },
  "content": [
    {
      "type": "text",
      "text": "# ${resourceName} API\n\n## GET ${apiBaseUrl}/${resourceName}\n\n### Example response\n\n{\n  \"data\": [\n"
    },
    {
      "type": "placeholder",
      "instructionType": "json_array_items",
      "config": {
        "description": "three ${resourceName} objects, each with an id string, a status string and a total number",
        "itemType": "object",
        "itemCount": 3
      }
    },
    {
      "type": "text",
      "text": "\n  ],\n  \"page\": 1,\n  \"pageSize\": 20,\n  \"total\": "
    },
    {
      "type": "placeholder",
      "instructionType": "json_number",
      "config": {
        "description": "a plausible total count of ${resourceName} across all pages",
        "numberType": "integer"
      }
    },
    {
      "type": "text",
      "text": ",\n  \"summary\": "
    },
    {
      "type": "placeholder",
      "instructionType": "json_value",
      "config": {
        "description": "a one-line summary string describing the ${resourceName} collection",
        "valueType": "string"
      }
    },
    {
      "type": "text",
      "text": "\n}"
    },
    {
      "type": "conditional",
      "condition": "includeErrorExample == true",
      "content": [
        {
          "type": "text",
          "text": "\n\n### Error response\n\n{\n  \"error\": {\n    \"code\": \"not_found\",\n    \"message\": "
        },
        {
          "type": "placeholder",
          "instructionType": "json_string",
          "config": {
            "description": "a human-readable message about a missing ${resourceName} resource"
          }
        },
        {
          "type": "text",
          "text": ",\n"
        },
        {
          "type": "placeholder",
          "instructionType": "json_object_fields",
          "config": {
            "description": "two additional diagnostic fields for the ${resourceName} error, indented to sit inside the error object",
            "fieldCount": 2
          }
        },
        {
          "type": "text",
          "text": "\n  }\n}"
        }
      ]
    }
  ]
}
